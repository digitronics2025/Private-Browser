{
  "name": "@private-browser/bridge-protocol",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    "./workspace-path": {
      "types": "./dist/workspace-path.d.ts",
      "import": "./dist/workspace-path.js",
      "default": "./dist/workspace-path.js"
    },
    "./agent-location": {
      "types": "./dist/agent-location.d.ts",
      "import": "./dist/agent-location.js",
      "default": "./dist/agent-location.js"
    },
    "./agent": {
      "types": "./dist/agent.d.ts",
      "import": "./dist/agent.js",
      "default": "./dist/agent.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./agent-permissions": {
      "types": "./dist/agent-permissions.d.ts",
      "import": "./dist/agent-permissions.js",
      "default": "./dist/agent-permissions.js"
    },
    "./agent-permission-model": {
      "types": "./dist/agent-permission-model.d.ts",
      "import": "./dist/agent-permission-model.js",
      "default": "./dist/agent-permission-model.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "4.6.7",
    "tldts": "^7.4.15"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vitest": "^5.0.0"
  }
}
