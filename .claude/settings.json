{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/ensure-test-browser.sh\"",
            "timeout": 320
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "mcp__cloudflare_mcp__search",
      "mcp__cloudflare_mcp__docs",
      "mcp__cloudflare_mcp__whoami",
      "mcp__cloudflare_mcp__execute",
      "Bash(npm run typecheck)",
      "Bash(npm run test)",
      "Bash(npm run check)",
      "Bash(npm run docs:check)",
      "Bash(npm run docs:find:*)",
      "Bash(node scripts/docs-find.mjs:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ]
  }
}
