{
  "name": "private-work-browser",
  "version": "0.5.0",
  "description": "A private, workspace-first Chromium browser for daily business operations.",
  "type": "module",
  "main": "dist-electron/main.js",
  "author": "Digitronics",
  "license": "UNLICENSED",
  "private": true,
  "workspaces": [
    "packages/bridge-protocol",
    "vscode-extension"
  ],
  "overrides": {
    "sharp": "0.35.4"
  },
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on tcp:5173 && npm run electron:compile && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron dist-electron/main.js\"",
    "dev:preview": "vite --host 127.0.0.1",
    "bridge:build": "npm run build --workspace @private-browser/bridge-protocol",
    "bridge:test": "npm run test --workspace @private-browser/bridge-protocol",
    "extension:compile": "npm run compile --workspace private-browser-bridge",
    "extension:test": "npm run test --workspace private-browser-bridge",
    "extension:package": "npm run bridge:build && npm run package --workspace private-browser-bridge",
    "extension:validate": "node scripts/stage-vsix.mjs --validate-only",
    "extension:stage": "node scripts/stage-vsix.mjs",
    "build": "npm run bridge:build && npm run typecheck && vite build && npm run electron:compile && npm run extension:compile",
    "electron:compile": "npm run bridge:build && tsc -p tsconfig.electron.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && npm run bridge:test && npm run extension:test && vitest run --config cloudflare/vitest.config.ts",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:headed": "npm run build && playwright test --headed",
    "test:electron": "npm run build && npm run test:electron:only",
    "test:electron:only": "node scripts/run-electron-tests.mjs",
    "test:electron:ci": "node scripts/run-electron-tests-if-supported.mjs",
    "worker:typecheck": "tsc -p cloudflare/tsconfig.json",
    "scripts:typecheck": "tsc -p cloudflare/tsconfig.scripts.json",
    "worker:build": "wrangler deploy --dry-run --config cloudflare/wrangler.jsonc --outdir .wrangler-dist",
    "worker:dev": "wrangler dev --config cloudflare/wrangler.jsonc",
    "docs:check": "node scripts/docs-guard.mjs",
    "secrets:check": "node scripts/secret-guard.mjs",
    "docs:find": "node scripts/docs-find.mjs",
    "docs:stale": "node scripts/docs-guard.mjs stale",
    "check": "npm run secrets:check && npm run docs:check && npm run bridge:build && npm run typecheck && npm run worker:typecheck && npm run scripts:typecheck && npm run test && npm run extension:package && npm run extension:validate && npm run build && npm run test:e2e && npm run test:electron:ci && npm run worker:build",
    "dist": "npm run extension:package && npm run build && electron-builder --win nsis --x64 --publish never && npm run extension:stage",
    "start": "electron dist-electron/main.js"
  },
  "dependencies": {
    "@private-browser/bridge-protocol": "*",
    "google-auth-library": "^11.0.2",
    "hash-wasm": "^4.12.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260910.1",
    "@electron/fuses": "1.8.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "44.3.0",
    "electron-builder": "^26.15.3",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^5.0.0",
    "wait-on": "^8.0.1",
    "wrangler": "^4.131.1",
    "yauzl": "^3.4.0"
  },
  "build": {
    "appId": "ma.digitronics.privatebrowser",
    "productName": "Private Browser",
    "asar": true,
    "electronDist": "node_modules/electron/dist",
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "loadBrowserProcessSpecificV8Snapshot": false,
      "grantFileProtocolExtraPrivileges": true
    },
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build",
        "to": ".",
        "filter": [
          "private-browser-update.json",
          "private-browser-bridge.vsix"
        ]
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "artifactName": "Private-Browser-${version}-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "4.63.1"
  }
}
